<?xml version="1.0"?>
<!--
  A 1:10 Ackermann vehicle, sized from the BFMC platform.

  One description serves both consumers: robot_state_publisher reads the
  URDF for TF and RViz, and Gazebo reads the same file (converted to SDF on
  spawn) for physics and sensors. Keeping it single-sourced is why the
  wheelbase the controller assumes and the wheelbase the simulator enforces
  cannot drift apart.

  The two details that matter to the rest of the project:

    * the IMU declares a gyro *bias*, not just white noise. That bias is
      what makes dead reckoning walk away, and estimating it is a third of
      what the EKF is for;
    * odometry is published as ground truth. Nothing on the vehicle is
      allowed to subscribe to it except the scoring and sensor-simulation
      nodes, which say so in their docstrings.
-->
<robot name="bfmc_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name" default="ego"/>
  <xacro:arg name="colour" default="0.15 0.35 0.75 1"/>
  <xacro:arg name="gyro_bias" default="0.02"/>

  <xacro:property name="name" value="$(arg name)"/>

  <!-- Geometry. These are the numbers DriverConfig defaults to. -->
  <xacro:property name="wheelbase" value="0.26"/>
  <xacro:property name="track_width" value="0.19"/>
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="body_length" value="0.36"/>
  <xacro:property name="body_width" value="0.16"/>
  <xacro:property name="body_height" value="0.055"/>
  <xacro:property name="body_mass" value="1.6"/>
  <xacro:property name="wheel_mass" value="0.08"/>
  <!-- Rear axle sits at the origin: the bicycle model the controller uses
       measures from the rear axle, so putting base_link anywhere else would
       introduce an offset that has to be remembered in three places. -->
  <xacro:property name="body_offset_x" value="0.10"/>

  <material name="body_colour">
    <color rgba="$(arg colour)"/>
  </material>
  <material name="tyre">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + width*width) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * radius * radius / 2.0}" iyz="0.0"
        izz="${mass * (3.0*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix parent x y steerable:=false">
    <xacro:if value="${steerable}">
      <link name="${prefix}_steer_link">
        <inertial>
          <mass value="0.02"/>
          <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
      </link>
      <joint name="${prefix}_steer_joint" type="revolute">
        <parent link="${parent}"/>
        <child link="${prefix}_steer_link"/>
        <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.52" upper="0.52" effort="10.0" velocity="8.0"/>
      </joint>
    </xacro:if>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <xacro:if value="${steerable}">
        <parent link="${prefix}_steer_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:if>
      <xacro:unless value="${steerable}">
        <parent link="${parent}"/>
        <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      </xacro:unless>
      <child link="${prefix}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.1</mu1>
      <mu2>1.1</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ==================================================== links ========= -->

  <link name="base_link">
    <visual>
      <origin xyz="${body_offset_x} 0 ${body_height/2 + wheel_radius - 0.01}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_colour"/>
    </visual>
    <collision>
      <origin xyz="${body_offset_x} 0 ${body_height/2 + wheel_radius - 0.01}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:box_inertia mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- A visible nose, so which way the car is pointing is obvious in a
       screenshot without having to infer it from motion. -->
  <link name="nose">
    <visual>
      <geometry><box size="0.04 0.10 0.03"/></geometry>
      <material name="tyre"/>
    </visual>
  </link>
  <joint name="nose_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nose"/>
    <origin xyz="${body_offset_x + body_length/2} 0 ${wheel_radius + body_height - 0.01}" rpy="0 0 0"/>
  </joint>

  <xacro:wheel prefix="rear_left"  parent="base_link" x="0"           y="${ track_width/2}"/>
  <xacro:wheel prefix="rear_right" parent="base_link" x="0"           y="${-track_width/2}"/>
  <xacro:wheel prefix="front_left"  parent="base_link" x="${wheelbase}" y="${ track_width/2}" steerable="true"/>
  <xacro:wheel prefix="front_right" parent="base_link" x="${wheelbase}" y="${-track_width/2}" steerable="true"/>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${body_offset_x} 0 ${wheel_radius + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================ gazebo =========== -->

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>model/${name}/imu</topic>
      <gz_frame_id>${name}/imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <z>
            <!-- The bias is the point. A pure white-noise gyro would let
                 dead reckoning hold heading almost indefinitely, and the
                 filter would have nothing to estimate. -->
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.004</stddev>
              <bias_mean>$(arg gyro_bias)</bias_mean>
              <bias_stddev>0.002</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>${track_width}</kingpin_width>
      <steering_limit>0.44</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
      <topic>model/${name}/cmd_vel</topic>
    </plugin>

    <!-- Ground truth. Used only for scoring and for simulating sensors;
         see the node docstrings for where that boundary is enforced. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>${name}/base_link</robot_base_frame>
      <odom_topic>model/${name}/odometry</odom_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>model/${name}/joint_state</topic>
    </plugin>
  </gazebo>

</robot>
