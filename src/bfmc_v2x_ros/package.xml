<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bfmc_v2x_ros</name>
  <version>1.0.0</version>
  <description>
    ROS 2 nodes for the BFMC V2X demonstration: the trackside localisation
    system and traffic lights, the vehicle-side radio, the delayed-fusion
    EKF, the behaviour arbiter, and the environment server that scores it.
  </description>
  <maintainer email="stefan.oanea@gmail.com">Stefan Oanea</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>bfmc_v2x</depend>
  <depend>bfmc_v2x_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_python</depend>

  <exec_depend>bfmc_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
